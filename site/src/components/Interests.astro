---
// The "other interests" row from Nathaniel's positioning slide. Line icons at
// 18px, drawn in currentColor so they follow the text in either palette and
// need no separate dark-mode assets.
//
// The motorcycle is deliberately built around an engine block, front fork and
// handlebar rather than a diamond frame — a two-circles-and-a-triangle glyph
// reads as a bicycle at this size.
---
<p class="interests-label">Other interests:</p>
<ul class="interests" aria-label="Other interests">
  <li>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="5" cy="16.5" r="3.6" />
      <circle cx="19" cy="16.5" r="3.6" />
      <rect x="8.6" y="11.4" width="6.4" height="4.2" rx="1.2" />
      <path d="M5 16.5 L8.6 15 M15 15 L19 16.5" />
      <path d="M13.6 11.4 L16.8 7.6 L20 7.6" />
      <path d="M8.6 11.6 L7 9 L10.4 9" />
    </svg>
    <span>Motorcycles</span>
  </li>
  <li>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 8.5 a4 4 0 0 1 4-4 h4 a4.5 4.5 0 0 1 4.5 4.5 v3 a3.5 3.5 0 0 1-3.5 3.5 h-5 a4 4 0 0 1-4-4 z" />
      <path d="M7 15.5 v2 a1.5 1.5 0 0 0 1.5 1.5 h6 a1.5 1.5 0 0 0 1.5-1.5 v-2" />
      <path d="M6.5 9.5 h4" />
    </svg>
    <span>Boxing</span>
  </li>
  <li>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3 L12 15 M12 15 L4.5 15 z" />
      <path d="M12 3 L19 15 L12 15" />
      <path d="M3 18 q4.5 3 9 0 t9 0" />
    </svg>
    <span>Sailing</span>
  </li>
  <li>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8.2 2.6 L10 4.2" />
      <path d="M10 4.2 q1.6 1.6 .6 3.4 q-2 3.6-1.6 7.6 q.5 4.6 5 5.2 q4.4 .6 5.8-3.4" />
      <path d="M17.4 19.6 L21.4 21" />
      <circle cx="10.6" cy="10.4" r=".85" />
      <circle cx="10.4" cy="13.6" r=".85" />
      <circle cx="11.4" cy="16.6" r=".85" />
    </svg>
    <span>Jazz</span>
  </li>
  <li>
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="6" width="18" height="13" rx="1.5" />
      <path d="M3 10 h18 M8 6 v4 M14 6 v4" />
      <path d="M3.5 6 L7 3 M9.5 6 L13 3 M15.5 6 L19 3" />
    </svg>
    <span>Film</span>
  </li>
</ul>
