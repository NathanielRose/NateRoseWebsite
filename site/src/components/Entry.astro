---
import MediaThumb from './MediaThumb.astro';
import ProjectDiagram from './ProjectDiagram.astro';

interface Props {
  title: string;
  /** Omit when there is nothing to link to — the title renders as plain text
      rather than a dead anchor. */
  href?: string;
  /** Institution, authors, stack. */
  meta?: string;
  /** Date or year, shown ahead of `meta`. */
  when?: string;
  desc?: string;
  poster?: string;
  video?: string;
  /** Id of a schematic in ProjectDiagram, used when there is no capture. */
  diagram?: string;
  badge?: string;
  external?: boolean;
  /** Secondary link, e.g. a local archived copy alongside a live original. */
  altHref?: string;
  altLabel?: string;
  /** One-line citation style: title, badge and metadata on a single row. */
  compact?: boolean;
}
const {
  title, href, meta, when, desc, poster, video, diagram, badge,
  external = false, altHref, altLabel = 'archived', compact = false,
} = Astro.props;

const hasMedia = !compact && Boolean(poster || video || diagram);
const linkAttrs = external ? { target: '_blank', rel: 'noopener' } : {};
const metaLine = [when, meta].filter(Boolean).join(' · ');

const Title = href ? 'a' : 'span';
const titleAttrs = href ? { href, ...linkAttrs } : {};
---
{compact ? (
  <article class="entry compact">
    <Title class="entry-title" {...titleAttrs}>{title}</Title>{badge && <span class="badge">{badge}</span>}
    {metaLine && <span class="entry-meta">{metaLine}</span>}
    {altHref && <a class="entry-alt" href={altHref}>[{altLabel}]</a>}
  </article>
) : (
  <article class:list={['entry', !hasMedia && 'no-media']}>
    {hasMedia && (
      href ? (
        <a href={href} {...linkAttrs} aria-hidden="true" tabindex="-1">
          {diagram
            ? <ProjectDiagram id={diagram} />
            : <MediaThumb poster={poster ?? '/images/placeholder.svg'} video={video} alt="" />}
        </a>
      ) : (
        diagram
          ? <ProjectDiagram id={diagram} />
          : <MediaThumb poster={poster ?? '/images/placeholder.svg'} video={video} alt="" />
      )
    )}
    <div>
      <Title class="entry-title" {...titleAttrs}>{title}</Title>{badge && <span class="badge">{badge}</span>}
      {metaLine && <div class="entry-meta">{metaLine}</div>}
      {desc && <p class="entry-desc">{desc}</p>}
    </div>
  </article>
)}
