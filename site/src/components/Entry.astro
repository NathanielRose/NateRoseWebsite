---
import MediaThumb from './MediaThumb.astro';
import ProjectDiagram from './ProjectDiagram.astro';

interface Props {
  title: string;
  /** Omit when there is nothing to link to — the title renders as plain text
      rather than a dead anchor. */
  href?: string;
  /** Publisher, authors, institution, stack. */
  meta?: string;
  /** Date or year. Sits at the end of the metadata line. */
  when?: string;
  desc?: string;
  poster?: string;
  video?: string;
  /** Id of a schematic in ProjectDiagram, used when there is no capture. */
  diagram?: string;
  badge?: string;
  external?: boolean;
  /** Citation style: title and badge on one line, metadata beneath. */
  compact?: boolean;
}
const {
  title, href, meta, when, desc, poster, video, diagram, badge,
  external = false, compact = false,
} = Astro.props;

const hasMedia = !compact && Boolean(poster || video || diagram);
const linkAttrs = external ? { target: '_blank', rel: 'noopener' } : {};

// Publisher and author read before the date, so the line answers "who
// published this" before "when".
const metaLine = [meta, when].filter(Boolean).join(' · ');

const Title = href ? 'a' : 'span';
const titleAttrs = href ? { href, ...linkAttrs } : {};
---
{compact ? (
  <article class="entry compact">
    <div class="entry-head">
      <Title class="entry-title" {...titleAttrs}>{title}</Title>{external && href && <svg class="ext" viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5 H2.5 v7 h7 v-2"/><path d="M7 2.5 h2.5 V5"/><path d="M9.4 2.6 L5.6 6.4"/></svg>}{badge && <span class="badge" data-badge={badge}>{badge}</span>}
    </div>
    {metaLine && <div class="entry-meta">{metaLine}</div>}
  </article>
) : (
  <article class:list={['entry', !hasMedia && 'no-media']}>
    {hasMedia && (
      href ? (
        <a href={href} {...linkAttrs} aria-hidden="true" tabindex="-1">
          {diagram
            ? <ProjectDiagram id={diagram} />
            : <MediaThumb poster={poster ?? '/images/placeholder.svg'} video={video} alt="" />}
        </a>
      ) : (
        diagram
          ? <ProjectDiagram id={diagram} />
          : <MediaThumb poster={poster ?? '/images/placeholder.svg'} video={video} alt="" />
      )
    )}
    <div>
      <Title class="entry-title" {...titleAttrs}>{title}</Title>{external && href && <svg class="ext" viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5 H2.5 v7 h7 v-2"/><path d="M7 2.5 h2.5 V5"/><path d="M9.4 2.6 L5.6 6.4"/></svg>}{badge && <span class="badge" data-badge={badge}>{badge}</span>}
      {metaLine && <div class="entry-meta">{metaLine}</div>}
      {desc && <p class="entry-desc">{desc}</p>}
    </div>
  </article>
)}
