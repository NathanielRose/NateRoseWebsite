---
import MediaThumb from './MediaThumb.astro';

interface Props {
  title: string;
  /** Omit when there is nothing to link to — the title renders as plain text
      rather than a dead anchor. */
  href?: string;
  /** Institution, authors, stack. */
  meta?: string;
  /** Date or year, shown ahead of `meta` on the same line. */
  when?: string;
  desc?: string;
  poster?: string;
  video?: string;
  badge?: string;
  external?: boolean;
}
const { title, href, meta, when, desc, poster, video, badge, external = false } = Astro.props;

// Rows without artwork collapse to a single column rather than showing a
// placeholder — a column of identical grey boxes reads as noise.
const hasMedia = Boolean(poster || video);
const linkAttrs = external ? { target: '_blank', rel: 'noopener' } : {};
const metaLine = [when, meta].filter(Boolean).join(' · ');
---
<article class:list={['entry', !hasMedia && 'no-media']}>
  {hasMedia && href && (
    <a href={href} {...linkAttrs} aria-hidden="true" tabindex="-1">
      <MediaThumb poster={poster ?? '/images/placeholder.svg'} video={video} alt="" />
    </a>
  )}
  {hasMedia && !href && (
    <MediaThumb poster={poster ?? '/images/placeholder.svg'} video={video} alt="" />
  )}
  <div>
    {href
      ? <a class="entry-title" href={href} {...linkAttrs}>{title}</a>
      : <span class="entry-title">{title}</span>
    }{badge && <span class="badge">{badge}</span>}
    {metaLine && <div class="entry-meta">{metaLine}</div>}
    {desc && <p class="entry-desc">{desc}</p>}
  </div>
</article>
