---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { projects } from '../data/projects';
import { publications } from '../data/publications';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/date';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const slugOf = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-/, '');
const recent = posts.slice(0, 3);

// The framing, and the career arc below it, follow Nathaniel's own positioning
// slide rather than the CV's reverse-chronological job list.
const forms = [
  {
    name: 'Human intelligence',
    body:
      'Neuroscience and cognitive science. Neural signatures as identity, and the philosophy of agency behind what makes a mind your own.',
  },
  {
    name: 'Artificial intelligence',
    body:
      'Machine learning and the infrastructure it runs on. Model security, and the attack surface that opens when systems read neural data.',
  },
  {
    name: 'Systemic intelligence',
    body:
      'How institutions think. Education policy, standardization, and governance, because standards decide who neurotech is safe for.',
  },
];

const arc = [
  { where: 'Microsoft', what: 'Software engineering' },
  { where: 'Imperial College London', what: 'MRes Neurotechnology' },
  { where: 'Ripple', what: 'Payments infrastructure' },
  { where: 'Circle', what: 'Stablecoin infrastructure' },
  { where: 'New venture', what: 'Neurosecurity, cognitive security' },
];
---
<Base title="Nathaniel Rose">
  <header class="identity">
    <picture>
      <source srcset="/images/headshot.webp" type="image/webp" />
      <img src="/images/headshot.jpg" alt="Nathaniel Rose" width="150" height="150" />
    </picture>
    <div>
      <h1>Nathaniel Rose</h1>
      <p class="tagline">Research Engineer. Neurosecurity and cognitive security. Oakland / London.</p>
      <div class="contact">
        <a href="mailto:nate@naterose.io">nate@naterose.io</a> <a href="/assets/NathanielRose_CV_2026.pdf">[cv]</a>
      </div>
    </div>
  </header>

  <p>
    I work on the security of neural data — the systems that carry it, the models
    that read it, and the standards that decide who it is safe for. Before that I
    spent a decade building the data and ML infrastructure underneath other
    people's models.
  </p>

  <h2>Interested in intelligence, in three forms</h2>
  <dl class="forms">
    {forms.map((f) => (
      <>
        <dt>{f.name}</dt>
        <dd>{f.body}</dd>
      </>
    ))}
  </dl>

  <h2>Bio</h2>
  <ol class="arc">
    {arc.map((step) => (
      <li><b>{step.where}</b><span>{step.what}</span></li>
    ))}
  </ol>
  <p>
    I started as an engineer at <b>Microsoft</b>, working on Kubernetes, Terraform and
    ML pipelines, then took an MRes in Neurotechnology at <b>Imperial College London</b>
    in the Brain and Behavior Lab, on gaze selection and brain-machine interfaces.
    I spent the next several years on financial infrastructure — senior MLOps
    engineer at <b>Ripple</b>, then staff data platform engineer at <b>Circle</b> — building
    feature stores, data catalogs and the orchestration underneath them.
  </p>
  <p>
    Along the way I co-founded <b>Lymbic AI</b> in London, which built EEG-based
    privacy-preserving biometrics and has since closed, and helped start the
    <b>Cerberus Neurosecurity Research Institute</b>. I'm now working on neurosecurity
    and cognitive security independently. Outside of that: motorcycles, boxing,
    sailing, and the philosophy of mind.
  </p>

  <h2>Publications</h2>
  <div class="entries tight">
    {publications.map((p) => (
      <Entry
        title={p.title}
        href={p.href}
        when={p.year}
        meta={p.meta}
        badge={p.badge}
        external={Boolean(p.href)}
        compact
      />
    ))}
  </div>

  <h2>Selected Projects</h2>
  <div class="entries">
    {projects.slice(0, 4).map((p) => (
      <Entry
        title={p.title}
        href={p.href}
        when={p.year}
        meta={p.meta}
        desc={p.desc}
        poster={p.poster}
        video={p.video}
        diagram={p.diagram}
        badge={p.badge}
        external={p.external}
      />
    ))}
  </div>
  <p><a href="/projects/">All projects →</a></p>

  <h2>Recent Writing</h2>
  <div class="entries tight">
    {recent.map((post) => (
      <Entry
        title={post.data.title}
        href={`/${slugOf(post.id)}/`}
        when={formatDate(post.data.date)}
        badge="Blog"
        compact
      />
    ))}
  </div>
  <p><a href="/writing/">All research &amp; writing →</a></p>
</Base>
