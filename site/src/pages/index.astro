---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import Interests from '../components/Interests.astro';
import { projects } from '../data/projects';
import { getFeed } from '../lib/entries';

// Same merged feed as /writing/, so "recent" here means genuinely recent
// rather than just the newest blog post.
const recent = (await getFeed()).slice(0, 5);

// Deiters' 1865 neuron drawing illustrates the human-intelligence column.
// The file is checked at build time so the figure simply appears once it is
// dropped in, and nothing 404s while it is absent.
const HUMAN_FIGURE = '/images/forms/neuron.jpg';
const hasHumanFigure = fs.existsSync(path.join(process.cwd(), 'public', HUMAN_FIGURE));

// The framing, and the career arc behind it, follow Nathaniel's own
// positioning slide rather than the CV's reverse-chronological job list.
const forms = [
  {
    name: 'Human intelligence',
    figure: true,
    body:
      'Neuroscience and cognitive science. Neural signatures as identity, and the philosophy of agency behind what makes a mind your own.',
  },
  {
    name: 'Artificial intelligence',
    body:
      'Machine learning and the infrastructure it runs on. Model security, and the attack surface that opens when systems read neural data.',
  },
  {
    name: 'Systemic intelligence',
    body:
      'How institutions and groups think — the collective intelligence that emerges between people rather than inside any one of them. Education policy, standardization, and governance.',
  },
];
---
<Base title="Nathaniel Rose">
  <header class="identity">
    <picture>
      <source srcset="/images/headshot.webp" type="image/webp" />
      <img src="/images/headshot.jpg" alt="Nathaniel Rose" width="150" height="150" />
    </picture>
    <div>
      <h1>Nathaniel Rose</h1>
      <p class="tagline">Research Engineer. Neurosecurity and cognitive security. Oakland / London.</p>
      <div class="contact">
        <a href="mailto:nate@naterose.io">nate@naterose.io</a> <a href="/assets/NathanielRose_CV_2026.pdf">[cv]</a>
      </div>
    </div>
  </header>

  <p>
    I work on the security of neural data — the systems that carry it, the models
    that read it, and the standards that decide who it is safe for. Before that I
    spent a decade building the data and ML infrastructure underneath other
    people's models.
  </p>

  <h2>Interested in intelligence, in three forms</h2>
  <dl class="forms cols">
    {forms.map((f) => (
      <>
        <dt>{f.name}</dt>
        <dd>
          {f.figure && hasHumanFigure && (
            <img class="form-figure" src={HUMAN_FIGURE} alt="Otto Deiters’ 1865 drawing of a neuron" loading="lazy" />
          )}
          {f.body}
        </dd>
      </>
    ))}
  </dl>

  <h2>Bio</h2>
  <div class="bio">
    <p>
      I started as an engineer at <b>Microsoft</b>, working on Kubernetes, Terraform
      and ML pipelines, then took an MRes in Neurotechnology at <b>Imperial College
      London</b> in the Brain and Behavior Lab, on gaze selection and brain-machine
      interfaces. I spent the next several years on financial infrastructure — senior
      MLOps engineer at <b>Ripple</b>, where I also served as president of Black at
      Ripple, then staff data platform engineer at <b>Circle</b> — building feature
      stores, data catalogs and the orchestration underneath them.
    </p>
    <p>
      Along the way I co-founded <b>Lymbic AI</b> in London, which built EEG-based
      privacy-preserving biometrics and has since closed, and helped start the <b>Cerberus Neurosecurity Research Institute</b>. I'm now working on neurosecurity
      and cognitive security independently: the systems that move neural data, the
      models that read it, and the standards that will decide who any of it is safe
      for.
    </p>
    <Interests />
  </div>

  <h2>Selected Projects</h2>
  <div class="entries">
    {projects.slice(0, 4).map((p) => (
      <Entry
        title={p.title}
        href={p.href}
        when={p.year}
        meta={p.meta}
        desc={p.desc}
        poster={p.poster}
        video={p.video}
        diagram={p.diagram}
        badge={p.badge}
        external={p.external}
      />
    ))}
  </div>
  <p><a href="/projects/">All projects →</a></p>

  <h2>Recent</h2>
  <div class="entries tight">
    {recent.map((row) => (
      <Entry
        title={row.title}
        href={row.href}
        when={row.when}
        meta={row.meta}
        badge={row.badge}
        external={row.external}
        compact
      />
    ))}
  </div>
  <p><a href="/writing/">All work →</a></p>
</Base>
