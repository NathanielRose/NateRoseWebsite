---
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import { getCollection } from 'astro:content';
import { SUBSTACK_URL, fetchSubstackPosts } from '../../data/substack';
import { publications } from '../../data/publications';
import { elsewhere } from '../../data/elsewhere';
import { archived } from '../../data/archive';
import { formatDate } from '../../lib/date';

const slugOf = (id: string) => id.replace(/^\d{4}-\d{2}-\d{2}-/, '');

type Row = {
  title: string;
  href?: string;
  when: string;
  sort: number;
  meta?: string;
  badge: string;
  external?: boolean;
  altHref?: string;
};

// Year-only items sort to the end of their year rather than claiming a day.
const endOfYear = (year: string) => new Date(Number(year), 11, 31).valueOf();

const papers: Row[] = publications.map((p) => ({
  title: p.title,
  href: p.href,
  when: p.year,
  sort: endOfYear(p.year),
  meta: p.meta,
  badge: p.badge,
  external: Boolean(p.href),
}));

// Talks, podcasts and pieces published elsewhere.
const external: Row[] = elsewhere.map((e) => ({
  title: e.title,
  href: e.href,
  when: e.date ? formatDate(new Date(e.date)) : (e.year ?? ''),
  sort: e.date ? new Date(e.date).valueOf() : e.year ? endOfYear(e.year) : 0,
  meta: e.meta,
  badge: e.badge,
  external: true,
}));

// Articles published elsewhere, each with a local copy kept as a fallback.
// While the original is up it stays the primary link, out of courtesy to the
// publisher, and the mirror is offered beside it. Once an original is gone,
// the local copy becomes the link.
const mirrors: Row[] = archived.map((a) => ({
  title: a.title,
  href: a.originalLive ? a.originalUrl : `/archive/${a.slug}/`,
  when: formatDate(new Date(a.date)),
  sort: new Date(a.date).valueOf(),
  meta: `${a.publication} · by ${a.author}`,
  badge: 'Article',
  external: a.originalLive,
  altHref: a.originalLive ? `/archive/${a.slug}/` : undefined,
}));

const blog: Row[] = (await getCollection('posts')).map((post) => ({
  title: post.data.title,
  href: `/${slugOf(post.id)}/`,
  when: formatDate(post.data.date),
  sort: post.data.date.valueOf(),
  badge: 'Blog',
}));

const newsletter: Row[] = (await fetchSubstackPosts()).map((item) => ({
  title: item.title,
  href: item.href,
  when: formatDate(item.date),
  sort: item.date.valueOf(),
  badge: 'Substack',
  external: true,
}));

// One list, newest first. Papers, talks, press, archived pieces and posts sit
// together and are told apart by their badge.
const all = [...papers, ...external, ...mirrors, ...blog, ...newsletter].sort(
  (a, b) => b.sort - a.sort
);
---
<Base title="Research & Writing – Nathaniel Rose">
  <h1>Research &amp; Writing</h1>

  <div class="subscribe">
    <span>
      {SUBSTACK_URL
        ? 'Longer-form pieces go out on the newsletter first.'
        : 'Newsletter not wired up yet — drop your Substack URL into src/data/substack.ts and those issues merge into this list automatically.'}
    </span>
    {SUBSTACK_URL && (
      <a href={SUBSTACK_URL} target="_blank" rel="noopener"><b>Subscribe →</b></a>
    )}
  </div>

  <div class="entries tight">
    {all.map((row) => (
      <Entry
        title={row.title}
        href={row.href}
        when={row.when}
        meta={row.meta}
        badge={row.badge}
        external={row.external}
        altHref={row.altHref}
        compact
      />
    ))}
  </div>
</Base>
