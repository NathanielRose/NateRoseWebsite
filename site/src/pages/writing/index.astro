---
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import { SUBSTACK_URL } from '../../data/substack';
import { getFeed } from '../../lib/entries';

// Papers, talks, press, archived pieces and posts in one list, told apart by
// their badge. See src/lib/entries.ts for how the feed is assembled.
const all = await getFeed();
---
<Base title="Research & Writing – Nathaniel Rose">
  <h1>Research &amp; Writing</h1>

  <div class="subscribe">
    <span>
      {SUBSTACK_URL
        ? 'Longer-form pieces go out on the newsletter first.'
        : 'Newsletter not wired up yet — drop your Substack URL into src/data/substack.ts and those issues merge into this list automatically.'}
    </span>
    {SUBSTACK_URL && (
      <a href={SUBSTACK_URL} target="_blank" rel="noopener"><b>Subscribe →</b></a>
    )}
  </div>

  <div class="entries tight">
    {all.map((row) => (
      <Entry
        title={row.title}
        href={row.href}
        when={row.when}
        meta={row.meta}
        badge={row.badge}
        external={row.external}
        compact
      />
    ))}
  </div>
</Base>
