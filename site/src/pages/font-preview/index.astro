---
// TEMPORARY comparison page — delete once a mono face and scope are chosen.
// Newsreader is fixed for headings/body; only the mono treatment varies.
const SERIF = '"Newsreader", Georgia, serif';
const MONO_FOR_SCOPE = '"IBM Plex Mono", monospace';

const faces = [
  {
    name: 'IBM Plex Mono',
    note: 'Currently applied. Warm and slightly humanist — closest in temperament to Newsreader, so it reads as part of the same family rather than a pasted-in terminal.',
    mono: '"IBM Plex Mono", monospace',
  },
  {
    name: 'JetBrains Mono',
    note: 'Taller x-height, more upright. Reads as unmistakably code. Strongest contrast against the serif, which can be the point or can feel bolted on.',
    mono: '"JetBrains Mono", monospace',
  },
  {
    name: 'Space Mono',
    note: 'Geometric and quirky, with distinctive angled terminals. Most personality of the four, and the most likely to date.',
    mono: '"Space Mono", monospace',
  },
  {
    name: 'DM Mono',
    note: 'Lighter and narrower than the others. Recedes rather than announces itself — good if the metadata should whisper.',
    mono: '"DM Mono", monospace',
  },
];

const scopes = [
  {
    name: 'Minimal — metadata line only',
    note: 'Mono confined to the stack/date line under each title. Everything else stays serif.',
    meta: true, badge: false, contact: false, tagline: false, nav: false,
  },
  {
    name: 'Balanced — metadata, badges, contact (currently applied)',
    note: 'Mono for anything that is data rather than prose: dates, stacks, the badge, the email and cv line.',
    meta: true, badge: true, contact: true, tagline: false, nav: false,
  },
  {
    name: 'Heavy — adds tagline and nav',
    note: 'Pushes mono into the identity line and navigation. Most technical overall; the serif starts to feel like it is only there for body copy.',
    meta: true, badge: true, contact: true, tagline: true, nav: true,
  },
];

const LETTERS = ['A', 'B', 'C', 'D'];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mono comparison</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=IBM+Plex+Mono:wght@400;500&family=JetBrains+Mono:wght@400;500&family=Space+Mono:wght@400;700&family=DM+Mono:wght@300;400&display=swap"
    />
    <style>
      :root {
        --bg: #fff; --fg: #1a1a1a; --muted: #6b6b6b;
        --rule: #e6e6e6; --link: #1a5fb4; --chip: #f2f2f2; --chipfg: #555;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --bg: #131315; --fg: #e8e8e8; --muted: #9a9a9a;
          --rule: #2c2c30; --link: #7ab0f0; --chip: #232327; --chipfg: #a8a8a8;
        }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); font-family: system-ui, sans-serif; }
      .page { max-width: 820px; margin: 0 auto; padding: 32px 16px 80px; }
      .lede { color: var(--muted); font-size: 15px; margin-bottom: 8px; line-height: 1.5; max-width: 66ch; }
      h2.group {
        font-size: 14px; letter-spacing: .08em; text-transform: uppercase;
        color: var(--muted); margin: 56px 0 0; padding-bottom: 8px; border-bottom: 2px solid var(--rule);
      }
      .sample { border-top: 1px solid var(--rule); padding-top: 14px; margin-top: 32px; }
      .label b { font-size: 14px; letter-spacing: .05em; text-transform: uppercase; }
      .why { color: var(--muted); font-size: 14px; margin: 6px 0 22px; line-height: 1.5; max-width: 66ch; }
      .demo { max-width: 780px; }
      .demo .nav {
        display: flex; gap: 18px; justify-content: flex-end;
        padding-bottom: 10px; border-bottom: 1px solid var(--rule); margin-bottom: 20px;
      }
      .demo h1 { font-size: 30px; margin: 0 0 4px; line-height: 1.25; font-weight: 600; }
      .demo .tag { font-weight: 600; margin: 0 0 2px; }
      .demo .contact { color: var(--muted); }
      .demo p.body { font-size: 18px; line-height: 1.6; }
      .demo h3 { font-size: 21px; margin: 26px 0 12px; padding-bottom: 6px; border-bottom: 1px solid var(--rule); font-weight: 600; }
      .row { display: grid; grid-template-columns: 150px 1fr; gap: 18px; align-items: start; margin-top: 16px; }
      .row .box { width: 150px; aspect-ratio: 5 / 3; background: var(--chip); border-radius: 4px; }
      .row a { color: var(--link); text-decoration: none; font-weight: 600; }
      .row .meta { color: var(--muted); }
      .row .desc { font-size: 16px; margin: 4px 0 0; line-height: 1.55; }
      .chip {
        display: inline-block; font-size: 10.5px; letter-spacing: .02em; text-transform: uppercase;
        background: var(--chip); color: var(--chipfg); border-radius: 3px; padding: 2px 6px;
        margin-left: 8px; vertical-align: 2px;
      }
    </style>
  </head>
  <body>
    <div class="page">
      <h1 style="font-size:24px;margin:0 0 8px">Mono comparison</h1>
      <p class="lede">
        Newsreader is fixed everywhere. The first group varies which monospace face
        carries the metadata; the second group fixes the face and varies how far mono
        spreads. Pick one from each — e.g. &ldquo;B and 2&rdquo;.
      </p>

      <h2 class="group">Part 1 — which mono face</h2>
      {faces.map((f, i) => (
        <section class="sample">
          <div class="label"><b>{LETTERS[i]}. {f.name}</b></div>
          <p class="why">{f.note}</p>
          <div class="demo">
            <div style={`font-family:${SERIF}`}>
              <h1>Nate Rose</h1>
              <p class="tag">Software Engineer. Cloud &amp; Distributed Systems. Bay Area.</p>
            </div>
            <div class="contact" style={`font-family:${f.mono};font-size:13.5px`}>nate@naterose.io [cv]</div>
            <p class="body" style={`font-family:${SERIF}`}>
              I build cloud SaaS applications, microservices, and big-data systems.
              I am interested in the infrastructure layer underneath machine learning.
            </p>
            <h3 style={`font-family:${SERIF}`}>Selected Projects</h3>
            <div class="row">
              <div class="box"></div>
              <div>
                <a style={`font-family:${SERIF}`}>Monte Carlo Simulator on Azure Service Fabric</a>
                <span class="chip" style={`font-family:${f.mono}`}>Blog</span>
                <div class="meta" style={`font-family:${f.mono};font-size:13.5px`}>
                  ASP.NET &middot; Service Fabric &middot; guest containers &middot; 2017
                </div>
                <p class="desc" style={`font-family:${SERIF}`}>
                  Converting a monolithic simulation app into containerised microservices
                  running on a Service Fabric cluster.
                </p>
              </div>
            </div>
          </div>
        </section>
      ))}

      <h2 class="group">Part 2 — how far mono spreads (shown in IBM Plex Mono)</h2>
      {scopes.map((s, i) => (
        <section class="sample">
          <div class="label"><b>{i + 1}. {s.name}</b></div>
          <p class="why">{s.note}</p>
          <div class="demo">
            <div
              class="nav"
              style={`font-family:${s.nav ? MONO_FOR_SCOPE : SERIF};font-size:${s.nav ? '13.5px' : '15px'}`}
            >
              <span>Main</span><span>Writing</span><span>Projects</span><span>Publications</span><span>CV</span>
            </div>
            <div style={`font-family:${SERIF}`}>
              <h1>Nate Rose</h1>
              <p
                class="tag"
                style={`font-family:${s.tagline ? MONO_FOR_SCOPE : SERIF};font-size:${s.tagline ? '14px' : 'inherit'}`}
              >
                Software Engineer. Cloud &amp; Distributed Systems. Bay Area.
              </p>
            </div>
            <div
              class="contact"
              style={`font-family:${s.contact ? MONO_FOR_SCOPE : SERIF};font-size:${s.contact ? '13.5px' : '15px'}`}
            >nate@naterose.io [cv]</div>
            <p class="body" style={`font-family:${SERIF}`}>
              I build cloud SaaS applications, microservices, and big-data systems.
              I am interested in the infrastructure layer underneath machine learning.
            </p>
            <h3 style={`font-family:${SERIF}`}>Selected Projects</h3>
            <div class="row">
              <div class="box"></div>
              <div>
                <a style={`font-family:${SERIF}`}>Monte Carlo Simulator on Azure Service Fabric</a>
                <span class="chip" style={`font-family:${s.badge ? MONO_FOR_SCOPE : SERIF}`}>Blog</span>
                <div
                  class="meta"
                  style={`font-family:${s.meta ? MONO_FOR_SCOPE : SERIF};font-size:${s.meta ? '13.5px' : '15px'}`}
                >
                  ASP.NET &middot; Service Fabric &middot; guest containers &middot; 2017
                </div>
                <p class="desc" style={`font-family:${SERIF}`}>
                  Converting a monolithic simulation app into containerised microservices
                  running on a Service Fabric cluster.
                </p>
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>
  </body>
</html>
